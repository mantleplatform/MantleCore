+/* MANTLE (#492): exactly equivalent to calling js_poll_interrupts() 'units'
+   times, without a per-unit branch. Charged for a tight native scan that
+   does 'units' steps of work and never polls (a linear duplicate check, a
+   string or typed-array search), so it is bounded by the interrupt handler
+   the same way the equivalent hand-written JS loop is. */
+static __exception int js_mantle_charge_interrupts(JSContext *ctx, int64_t units)
+{
+    while (units > 0) {
+        if (units < ctx->interrupt_counter) {
+            ctx->interrupt_counter -= (int)units;
+            return 0;
+        }
+        /* the poll that takes the counter to zero (or the next one, if it
+           is already there) calls the handler */
+        units -= max_int(ctx->interrupt_counter, 1);
+        if (__js_poll_interrupts(ctx))
+            return -1;
+    }
+    return 0;
+}
