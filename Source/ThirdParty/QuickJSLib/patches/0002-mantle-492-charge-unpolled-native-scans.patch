+/* MANTLE (#492, see ../patches/README.txt): the handler above runs once per
+   JS_MANTLE_INTERRUPT_COUNTER_INIT interrupt polls (upstream: 10000), so an
+   embedder's wall-clock check inside it sees a loop of heavy native calls ten
+   times sooner. Budgets counted in handler calls keep upstream's unit by
+   counting JS_MANTLE_INTERRUPTS_PER_BUDGET_UNIT calls as one. libregexp.c's
+   own INTERRUPT_COUNTER_INIT is lowered to the same value. */
+#define JS_MANTLE_INTERRUPT_COUNTER_INIT 1000
+#define JS_MANTLE_INTERRUPTS_PER_BUDGET_UNIT (10000 / JS_MANTLE_INTERRUPT_COUNTER_INIT)
