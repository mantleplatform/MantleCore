{
  "schemaVersion": 1,
  "id": "sedan",
  "name": "Sedan",
  "description": "A four-door road car: saloons and estates. Handles like a sports car, a little softer.",
  "comment": "A vehicle preset (#728): the starting point a creator picks before choosing their mesh. defaults is a vehicle document fragment (schema/vehicle.schema.json) the plugin writes into a new vehicle; ranges narrows placeAssets.vehicle.ranges in schema/avatar/limits.json for a vehicle built from this preset, by the same paths, and never widens them. fit sizes the creator's mesh for the 165.6 cm Mantle character: one uniform scale from the mesh's wheel radius and track width (wheel-center to wheel-center across an axle) against these typical values, never from the wheelbase, so a stretched limousine keeps its length. Values are tuned against the owner's Fab test pack, where the real-scale Vol 2 sedan comes out at about 1.0.",
  "movementType": "wheeled",
  "publishable": true,
  "type": "car",
  "seats": {
    "driver": "car",
    "passenger": "car"
  },
  "fit": {
    "wheelRadius": 32,
    "trackWidth": 165,
    "minScale": 0.5,
    "maxScale": 2
  },
  "wheels": {
    "min": 4,
    "max": 6
  },
  "chassis": {
    "layout": {
      "wheelbase": 273,
      "track": 165,
      "wheelRadius": 32,
      "wheelWidth": 21,
      "axles": [
        { "steer": true, "drive": true },
        { "steer": false, "drive": false, "handbrake": true }
      ]
    },
    "body": { "length": 470, "width": 182, "height": 70, "groundClearance": 20 },
    "centerOfMass": [25, 0, 46],
    "seat": {
      "location": [0, -36, 76],
      "steeringWheel": { "location": [46.8, -36, 79], "radius": 19 }
    }
  },
  "derive": {
    "stability": 1.15,
    "cameraArmPerLength": 0.63,
    "cameraHeightPerHeight": 1.1
  },
  "defaults": {
    "mass": 1546,
    "maxSpeed": 5944,
    "dragCoefficient": 0.31,
    "frontalArea": 2.6,
    "engine": {
      "sound": "inline4",
      "maxTorque": 249,
      "maxRPM": 7000,
      "idleRPM": 900,
      "torqueCurve": [[0, 0.6], [1000, 0.7], [2500, 0.88], [4800, 1], [6600, 0.877], [7000, 0.8]],
      "tractionControl": true,
      "engineBraking": 0.08
    },
    "transmission": {
      "gearRatios": [5.25, 3.028, 1.95, 1.456, 1.22, 1.0, 0.808, 0.673],
      "reverseRatio": 4.014,
      "finalDrive": 2.685,
      "changeUpRPM": 6600,
      "changeDownRPM": 2000,
      "shiftTime": 0.3
    },
    "suspension": {
      "maxRaise": 10,
      "maxDrop": 16,
      "springRate": 150,
      "springPreload": 50,
      "damping": 0.57
    },
    "steering": {
      "maxAngle": 40,
      "ackermann": true
    },
    "brakes": {
      "brakeTorque": 4300,
      "handbrakeTorque": 6000,
      "abs": true,
      "frontShare": 0.65
    },
    "tires": {
      "friction": 1.5
    },
    "camera": {
      "armLength": 420,
      "height": 160
    }
  },
  "ranges": {
    "mass": [900, 2200],
    "maxSpeed": [2500, 6500],
    "dragCoefficient": [0.2, 0.5],
    "engine/maxTorque": [120, 1200],
    "engine/maxRPM": [4000, 9000],
    "engine/idleRPM": [600, 1200],
    "engine/engineBraking": [0, 0.3],
    "transmission/shiftTime": [0.05, 1],
    "suspension/maxRaise": [3, 20],
    "suspension/maxDrop": [3, 25],
    "suspension/springRate": [50, 800],
    "suspension/damping": [0.2, 0.9],
    "steering/maxAngle": [25, 50],
    "brakes/brakeTorque": [1000, 6000],
    "brakes/frontShare": [0.5, 0.8],
    "tires/friction": [0.8, 5],
    "wheels/*/radius": [22, 45]
  }
}
