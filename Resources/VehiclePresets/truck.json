    "driver": "car",
    "passenger": "car"
  },
  "fit": {
    "wheelRadius": 42,
    "trackWidth": 168,
    "minScale": 0.5,
    "maxScale": 2
  },
  "wheels": {
    "min": 4,
    "max": 8
  },
  "chassis": {
    "layout": {
      "wheelbase": 350,
      "track": 168,
      "wheelRadius": 42,
      "wheelWidth": 28,
      "axles": [
        { "steer": true, "drive": false },
        { "steer": false, "drive": true, "handbrake": true }
      ]
    },
    "body": { "length": 640, "width": 205, "height": 96, "groundClearance": 48 },
