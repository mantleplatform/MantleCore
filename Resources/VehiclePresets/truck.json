    "engine/maxRPM": [2500, 5000],
    "engine/idleRPM": [400, 900],
    "suspension/maxRaise": [5, 40],
    "suspension/maxDrop": [5, 40],
    "suspension/springRate": [200, 1500],
    "suspension/damping": [0.2, 0.9],
    "steering/maxAngle": [20, 45],
